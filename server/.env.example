# PostgreSQL connection settings. Copy these names to server/.env and provide
# your own local password; never commit server/.env.
PGHOST=localhost
PGPORT=5432
PGDATABASE=pokefolio
PGUSER=postgres
PGPASSWORD=replace-with-your-local-postgres-password

# Backend-only Pokémon TCG API credential.
POKEMON_TCG_API_KEY=replace-with-your-pokemon-tcg-api-key
