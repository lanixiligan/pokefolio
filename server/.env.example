# PostgreSQL connection settings.
# Copy these names to server/.env and provide
# your own local password; never commit server/.env.
PGHOST=localhost
PGPORT=5432
PGDATABASE=pokefolio
PGUSER=postgres
PGPASSWORD=replace-with-your-local-postgres-password

# Backend-only Pokémon TCG API credential.
# Register and verify your email at https://dev.pokemontcg.io/
# then obtain your API key from the Developer Portal dashboard.
# Put the real key only in server/.env; never commit it,
# expose it to the frontend, or include it in documentation.
POKEMON_TCG_API_KEY=replace-with-your-pokemon-tcg-api-key